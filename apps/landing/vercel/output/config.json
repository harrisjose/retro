{
  "version": 3,
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/retro-images/(.*)",
      "dest": "/retro-images/$1"
    },
    {
      "src": "/[^/]+\\.[^/]+$",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}
