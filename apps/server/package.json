{
  "name": "api",
  "type": "module",
  "scripts": {
    "predev": "npm run migrate-up",
    "dev": "doppler run -- tsx watch --inspect src/index.ts",
    "kysely": "doppler run -- kysely",
    "migrate-up": "npm run kysely migrate up",
    "migrate-down": "npm run kysely migrate down",
    "setup-better-auth": "doppler run -- cli migrate --config ./src/lib/auth.ts",
    "db:setup": "npm run setup-better-auth && npm run migrate-up",
    "db:generate": "doppler run -- tsx src/db/generate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/trpc-server": "^0.3.4",
    "@trpc/server": "^10.45.2",
    "better-auth": "^1.1.2",
    "hono": "^4.6.14",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.1.2",
    "@types/node": "^20.11.17",
    "@types/pg": "^8.11.10",
    "kysely-codegen": "^0.17.0",
    "kysely-ctl": "^0.10.1",
    "tsx": "^4.7.1"
  }
}
