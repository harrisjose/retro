{
  "packageManager": "pnpm@10.6.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/harrisjose/retro"
  },
  "scripts": {
    "format": "biome format --write .",
    "cleanup": "pnpm -r exec rm -rf node_modules && rm -rf node_modules",
    "pkg:build": "pnpm --parallel --filter \"./packages/**\" build",
    "build:server": "docker build --platform=linux/amd64 . --target server --tag retro-server:latest",
    "build:web": "docker build --platform=linux/amd64 . --target web --tag retro-web:latest"
  },
  "dependencies": {
    "@types/lodash-es": "^4.17.12",
    "better-auth": "^1.1.11",
    "lib0": "^0.2.99",
    "lodash-es": "^4.17.21",
    "y-utility": "^0.1.4",
    "yjs": "13.6.23",
    "yjs-types": "^0.0.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-musl": "*"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.1.11",
    "@biomejs/biome": "1.9.4",
    "lefthook": "^1.10.3",
    "typescript": "^5.7.2"
  }
}
